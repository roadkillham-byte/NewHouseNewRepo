# Copy this file to .env.local and fill in real values. .env.local is
# gitignored — never commit real secrets.

# Supabase Postgres connection string (use the "Transaction pooler" URI from
# Supabase Settings > Database > Connection string).
DATABASE_URL="postgresql://user:password@host:6543/postgres"

# Auth.js — generate with: npx auth secret
AUTH_SECRET="replace-with-a-long-random-string"

# Base URL of the deployed app (used for callback URLs). For local dev:
NEXTAUTH_URL="http://localhost:3000"

# Optional: secret shared with the Vercel Cron job so /api/cron/materialise
# rejects requests that don't carry it. Generate any long random string.
CRON_SECRET="replace-with-a-long-random-string"
